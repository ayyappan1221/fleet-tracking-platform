# Backend API base URL — used by axios in src/api.js
# Development: uncomment the line below to hit local FastAPI on port 8000
# VITE_API_URL=http://localhost:8000/api

# Production: set to your Render backend URL (without trailing slash)
# VITE_API_URL=https://<your-app>.onrender.com/api

# When VITE_API_URL is unset, Vite dev proxy forwards /api to localhost:8000
# In production (Vercel), /api requests are NOT rewritten — they go to the backend URL above
