# Database
# SQLite is used by default so you can run the app without extra setup.
DATABASE_URL=sqlite:///./fleet.db
# For production, switch to PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://fleet_user:your_password_here@localhost/fleet_db

# App
APP_ENV=development
DEBUG=true
APP_PORT=8000
APP_HOST=0.0.0.0

# Security
SECRET_KEY=change-this-to-a-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Auth
BCRYPT_ROUNDS=12
